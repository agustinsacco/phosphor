---
/**
 * A terminal block that types its lines. Reduced motion (or no JS) shows the
 * finished transcript. Lines starting with `$ ` are commands; the rest is
 * output and appears at once after its command lands.
 */
interface Props {
  lines: string[]
  title?: string
  class?: string
}
const { lines, title = 'zsh — ~', class: cls = '' } = Astro.props

// The finished transcript, pre-rendered so the no-JS / reduced-motion page is
// complete. Built as a string: JSX inside <pre> trips Astro's parser.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
const html = lines
  .map((l) =>
    l.startsWith('$ ')
      ? `<span class="text-text-tertiary">$ </span>${esc(l.slice(2))}\n`
      : `<span class="text-text-secondary">${esc(l)}</span>\n`,
  )
  .join('')
---

<div class={`overflow-hidden rounded-[10px] border border-border-strong bg-sidebar ${cls}`}>
  <div class="flex items-center gap-2 border-b border-border bg-bg px-4 py-2">
    <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
    <span class="eyebrow ml-2">{title}</span>
  </div>
  <pre
    class="terminal-body m-0 overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-text"
    data-lines={JSON.stringify(lines)}
    aria-label="Install commands"
    set:html={html}
  />
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const blocks = document.querySelectorAll<HTMLPreElement>('pre.terminal-body[data-lines]')
  blocks.forEach((pre) => {
    if (reduce) return
    const lines: string[] = JSON.parse(pre.dataset.lines ?? '[]')
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        io.disconnect()
        type(pre, lines)
      },
      { threshold: 0.3 },
    )
    io.observe(pre)
  })

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))

  async function type(pre: HTMLPreElement, lines: string[]) {
    pre.textContent = ''
    const cursor = document.createElement('span')
    cursor.className = 'streaming-cursor'
    pre.appendChild(cursor)
    for (const line of lines) {
      if (line.startsWith('$ ')) {
        const prompt = document.createElement('span')
        prompt.className = 'text-text-tertiary'
        prompt.textContent = '$ '
        pre.insertBefore(prompt, cursor)
        const cmd = document.createElement('span')
        pre.insertBefore(cmd, cursor)
        await sleep(350)
        for (const ch of line.slice(2)) {
          cmd.textContent += ch
          await sleep(ch === ' ' ? 60 : 22 + Math.random() * 26)
        }
        await sleep(420)
        pre.insertBefore(document.createTextNode('\n'), cursor)
      } else {
        const out = document.createElement('span')
        out.className = 'text-text-secondary'
        out.textContent = line + '\n'
        pre.insertBefore(out, cursor)
        await sleep(140)
      }
    }
  }
</script>
