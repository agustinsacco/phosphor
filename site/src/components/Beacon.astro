---
/** The Phosphor Beacon — the app's shared working/loading mark, same SVG. */
interface Props {
  size?: number
  label?: string
  class?: string
}
const { size = 24, label = 'Working', class: cls = '' } = Astro.props
---

<span
  class={`phosphor-loader ${cls}`}
  style={`width:${size}px;height:${size}px`}
  role="img"
  aria-label={label}
>
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <circle class="phosphor-loader-shell" cx="16" cy="16" r="11"></circle>
    <circle class="phosphor-loader-inner" cx="16" cy="16" r="6"></circle>
    <circle class="phosphor-loader-core" cx="16" cy="16" r="3"></circle>
    <g class="phosphor-loader-orbit">
      <path d="M5 16a11 11 0 0 1 11-11" stroke-width="2.5" stroke-linecap="round"></path>
      <circle cx="16" cy="5" r="2.5" fill="currentColor" stroke="none"></circle>
    </g>
  </svg>
</span>
