---
/**
 * The electron-shell mark (build/icon.svg), inline so the electrons can move.
 * Geometry is chemistry, not taste: shells at r=170/255/340 (85px apart),
 * 2 · 8 · 5 electrons — phosphorus's configuration. Only the electrons and the
 * bloom animate; the shells and the P never do. `tile` draws the graphite app
 * tile behind it (the app icon); without it the mark sits on the page.
 */
interface Props {
  size?: number
  tile?: boolean
  animated?: boolean
  class?: string
  label?: string
}
const { size = 48, tile = false, animated = true, class: cls = '', label } = Astro.props
const cx = 512
const cy = 470
const shells = [
  { r: 170, n: 2, cls: 'mark-shell--1' },
  { r: 255, n: 8, cls: 'mark-shell--2' },
  { r: 340, n: 5, cls: 'mark-shell--3' },
]
const electrons = (r: number, n: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2 - Math.PI / 2
    return { x: +(cx + r * Math.cos(a)).toFixed(1), y: +(cy + r * Math.sin(a)).toFixed(1) }
  })
const id = `pm-${Math.random().toString(36).slice(2, 8)}`
---

<svg
  viewBox="0 0 1024 1024"
  width={size}
  height={size}
  class={cls}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-animated={animated}
>
  <defs>
    <linearGradient id={`${id}-p`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f2ab4e"></stop>
      <stop offset="100%" stop-color="#e2922e"></stop>
    </linearGradient>
    <radialGradient id={`${id}-b`} cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f2ab4e" stop-opacity="0.24"></stop>
      <stop offset="45%" stop-color="#eca03d" stop-opacity="0.11"></stop>
      <stop offset="100%" stop-color="#eca03d" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  {tile && <rect width="1024" height="1024" rx="228" fill="#1f1c18" />}
  <circle class={animated ? 'mark-bloom' : ''} cx={cx} cy={cy} r="330" fill={`url(#${id}-b)`}
  ></circle>
  <g stroke="#eca03d" fill="none">
    <circle cx={cx} cy={cy} r="170" stroke-width="10" opacity="0.16"></circle>
    <circle cx={cx} cy={cy} r="255" stroke-width="10" opacity="0.13"></circle>
    <circle cx={cx} cy={cy} r="340" stroke-width="10" opacity="0.10"></circle>
  </g>
  {
    shells.map((s) => (
      <g class={animated ? `mark-shell ${s.cls}` : ''} fill="#eca03d">
        {electrons(s.r, s.n).map((e) => (
          <circle cx={e.x} cy={e.y} r="11" opacity="0.7" />
        ))}
      </g>
    ))
  }
  <g transform="translate(161.7 153.8) scale(0.62)">
    <path
      d="M340 220 H560 C700 220 790 305 790 425 C790 545 700 630 560 630 H430 V800 H340 Z M430 310 H552 C640 310 700 355 700 425 C700 495 640 540 552 540 H430 Z"
      fill={`url(#${id}-p)`}
      fill-rule="evenodd"></path>
  </g>
  {
    tile && (
      <text
        x="512"
        y="850"
        text-anchor="middle"
        font-family="'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace"
        font-size="64"
        fill="#eca03d"
        opacity="0.7"
      >
        2 · 8 · 5
      </text>
    )
  }
</svg>
