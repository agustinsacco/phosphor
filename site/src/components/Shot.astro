---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  priority?: boolean
  sizes?: string
}
const {
  src,
  alt,
  caption,
  priority = false,
  sizes = '(min-width: 1440px) 1344px, 94vw',
} = Astro.props
---

<figure class="shot">
  <a
    class="shot-image"
    href={src.src}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${alt} — open full-size image in a new tab`}
  >
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1440, 1920, 2880]}
      sizes={sizes}
      format="webp"
      quality={82}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </a>
  {
    caption && (
      <figcaption>
        <>
          <span>{caption}</span>
          <span>Real app capture · select to enlarge ↗</span>
        </>
      </figcaption>
    )
  }
</figure>
