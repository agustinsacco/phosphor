---
import BaseLayout from '../layouts/BaseLayout.astro'
import Evidence from '../components/Evidence.astro'
import Shot from '../components/Shot.astro'
import home from '../assets/shots/home.webp'
import { GITHUB, PI_NPM } from '../lib/content'
---

<BaseLayout
  title="Phosphor — keep the work in your hands"
  description="A desktop workspace for coding with agents. Direct the task, inspect the changes, and take the next turn. Your files, your models, powered by pi."
>
  <section class="hero container">
    <div class="hero-meta label">
      <p class="signal">A desktop workspace for coding with agents</p>
      <p>Local workspace / open source</p>
    </div>
    <div class="hero-grid">
      <h1 class="display">Keep the work<br />in your hands<span class="muted">.</span></h1>
      <div class="hero-copy">
        <p class="lede">
          Give the agent a direction. See what it changes. Make the next call. Phosphor brings the
          conversation, your code, and the tools to check it into one desktop workspace.
        </p>
        <div class="actions">
          <a class="action" href="/download">Get Phosphor <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={GITHUB}>Read the source <span aria-hidden="true">↗</span></a>
        </div>
        <p class="label">macOS · Linux · Windows¹ &nbsp; / &nbsp; Powered by pi</p>
      </div>
    </div>
    <Evidence />
  </section>

  <section id="workbench" class="section work-surface">
    <div class="container section-grid">
      <div class="section-index">
        <span class="number">01 /</span><p class="label">A working <br />relationship</p>
      </div>
      <div class="section-content">
        <h2 class="title">The first answer<br />is a starting point.</h2>
        <p class="lede">
          Good software takes more than a prompt. You bring the context and the judgment. The agent
          does the legwork. Phosphor keeps the exchange close to the work itself.
        </p>
        <ol class="turns">
          <li>
            <span class="turn-number" aria-hidden="true">01</span><h3>Direct.</h3><p>
              Open a project. Describe what should change and what should stay. Reference a file,
              choose a model, and start a session.
            </p>
          </li>
          <li>
            <span class="turn-number" aria-hidden="true">02</span><h3>Inspect.</h3><p>
              Follow the tool calls. Open an edit’s diff. Read the file or run a check in the
              terminal beside the conversation.
            </p>
          </li>
          <li>
            <span class="turn-number" aria-hidden="true">03</span><h3>Revise.</h3><p>
              Steer a running turn, queue a follow-up, or fork an earlier point to try another
              direction. Keep the useful parts. Change your mind.
            </p>
          </li>
        </ol>
        <p class="return-note">
          <svg viewBox="0 0 32 24" fill="none" aria-hidden="true"
            ><path d="M30 2v12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.5"></path></svg
          >Back to you. Not back to zero.
        </p>
      </div>
    </div>
  </section>

  <section id="lanes" class="section container">
    <div class="section-grid">
      <div class="section-index">
        <span class="number">02 /</span><p class="label">Room for <br />parallel thought</p>
      </div>
      <div class="section-content">
        <div class="split-copy">
          <h2 class="title">Several threads.<br />A clear next move.</h2>
          <div>
            <p>
              A fix in one session. An experiment in another. Give each its own branch and worktree.
              The home board groups lanes by what they need from you, with spend and usage in view.
            </p><a class="text-link" href="/workbench#lanes"
              >How lanes work <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <Shot
          src={home}
          alt="Phosphor’s home board showing a lane ready to merge, idle lanes, and the project’s spend ledger"
          caption="Your attention goes where it is needed. The board is derived from project state, not another agent running in the background."
          sizes="(min-width: 1440px) 1088px, (min-width: 760px) 75vw, 94vw"
        />
      </div>
    </div>
  </section>

  <section id="providers" class="section container">
    <div class="section-grid">
      <div class="section-index">
        <span class="number">03 /</span><p class="label">Your setup. <br />Not a walled garden.</p>
      </div>
      <div class="section-content">
        <h2 class="title">Choose the model.<br />Keep the workspace.</h2>
        <p class="lede">
          Phosphor is a desktop home for the <a href={PI_NPM}>pi coding agent</a>, not a new model
          subscription. Bring supported subscriptions, API keys, or a local endpoint. Switch models
          without starting the conversation over.
        </p>
        <dl class="fact-list">
          <div>
            <dt>Your models</dt><dd>
              Claude, OpenAI, Gemini, Bedrock, OpenRouter, and the rest of pi’s provider ecosystem.
              Claude subscriptions connect through the Claude Code provider package.
            </dd>
          </div>
          <div>
            <dt>Your tools</dt><dd>
              Files and a real terminal, plus MCP connectors and pi extensions for the services your
              work depends on.
            </dd>
          </div>
          <div>
            <dt>Your machine</dt><dd>
              Local project folders and sessions. No Phosphor cloud workspace. Requests still go to
              the model providers and connected services you choose.
            </dd>
          </div>
        </dl>
        <a class="text-link" href="/workbench#providers"
          >Providers and connections <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>

  <section id="install" class="closing container">
    <div>
      <p class="label">A place for your next turn</p><h2 class="title">
        Bring a project.<br />Take it somewhere.
      </h2>
    </div>
    <a class="text-link" href="/download">Install Phosphor <span aria-hidden="true">↗</span></a>
  </section>
  <p class="container label muted" style="padding-bottom: 2rem">
    ¹ Windows installers ship on tagged releases. Setup requires pi and Node.js 22.19+.
  </p>
</BaseLayout>
