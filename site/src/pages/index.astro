---
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import PhosphorMark from '../components/PhosphorMark.astro'
import Beacon from '../components/Beacon.astro'
import Shot from '../components/Shot.astro'
import Terminal from '../components/Terminal.astro'
import Architecture from '../components/Architecture.astro'
import {
  providers,
  connectors,
  bundledExtensions,
  settingsTabs,
  laneColumns,
  prChipStates,
  installLines,
  GITHUB,
  LATEST,
  INSTALL_SH,
  PI_CLAUDE_CLI,
} from '../lib/content'

import shotChat from '../assets/shots/chat.webp'
import shotChanges from '../assets/shots/changes.webp'
import shotHome from '../assets/shots/home.webp'
import shotModels from '../assets/shots/models.webp'
import shotThinking from '../assets/shots/thinking.webp'
import shotContext from '../assets/shots/context.webp'
import shotCommands from '../assets/shots/commands.webp'
import shotMentions from '../assets/shots/mentions.webp'
import shotFiles from '../assets/shots/files.webp'
import shotFilesLeft from '../assets/shots/files-left.webp'
import shotFilesFull from '../assets/shots/files-full.webp'
import shotTerminal from '../assets/shots/terminal.webp'
import shotArtifacts from '../assets/shots/artifacts.webp'
import shotSettings from '../assets/shots/settings.webp'
import shotAccounts from '../assets/shots/accounts.webp'
import shotConnectors from '../assets/shots/connectors.webp'
import shotLight from '../assets/shots/light.webp'

const title = 'Phosphor — the pi coding agent, extended into a desktop IDE'
const description =
  'Phosphor is a multi-provider agentic IDE for macOS, Linux and Windows, powered by the pi coding agent. Sign in with the subscriptions you already pay for, route work across accounts, and keep chat, diffs, files, terminal and artifacts in one window.'
const installCmd = `curl -fsSL ${INSTALL_SH} | sh`
const toneClass: Record<string, string> = {
  success: 'chip--success',
  danger: 'chip--danger',
  merged: 'chip--merged',
  muted: '',
}
const kindLabel: Record<string, string> = {
  plan: 'plan',
  key: 'key',
  gateway: 'gateway',
  local: 'local',
}
---

<BaseLayout title={title} description={description}>
  <Nav />

  <main id="main" tabindex="-1">
    <!-- ============================================================ HERO -->
    <section class="relative overflow-hidden pt-32 pb-12 md:pt-40 md:pb-20">
      <div class="hero-glow"></div>
      <div class="hero-ground"></div>
      <div
        class="pointer-events-none absolute -top-24 -right-56 hidden opacity-[0.32] lg:block xl:-right-32"
        aria-hidden="true"
      >
        <PhosphorMark size={880} />
      </div>

      <div class="relative mx-auto max-w-7xl px-4 md:px-6">
        <p class="eyebrow eyebrow--accent flex items-center gap-2" data-reveal>
          <Beacon size={18} label="Phosphor" />
          Powered by the pi coding agent
        </p>
        <h1 class="headline mt-6 max-w-4xl text-4xl md:text-5xl" data-reveal style="--i: 1">
          The pi coding agent,<br class="hidden sm:block" /> extended into a desktop IDE.
        </h1>
        <p class="lede mt-7 max-w-2xl text-lg" data-reveal style="--i: 2">
          Open a project folder, describe a task, and work alongside the agent — a transcript that
          renders what models actually produce, the files, terminal and artifacts beside it, and
          every change reviewable. One window for every provider pi speaks, running on your own
          machine with your own keys and subscriptions.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--i: 3">
          <a class="btn btn--accent" href="#install">Install Phosphor</a>
          <a class="btn" href={GITHUB} target="_blank" rel="noopener noreferrer">View on GitHub</a>
          <button
            class="btn btn--ghost group font-mono text-[12.5px]"
            type="button"
            data-copy={installCmd}
            aria-label="Copy the install command"
          >
            <span class="text-text-tertiary">$</span>
            <span class="truncate max-w-[52vw] sm:max-w-none">curl -fsSL …/install.sh | sh</span>
            <span class="eyebrow ml-1 group-hover:text-text" data-copy-label>copy</span>
          </button>
        </div>

        <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-2" data-reveal style="--i: 4">
          {
            [
              'macOS · Linux · Windows',
              `${providers.length} providers`,
              'Subscription sign-in',
              'Sessions are real pi processes',
              'MIT',
            ].map((s) => <li class="eyebrow">{s}</li>)
          }
        </ul>

        <div class="mt-16" data-reveal style="--i: 5">
          <Shot
            src={shotChat}
            alt="A finished Phosphor turn: the prompt, the activity run expanded on a README edit's diff, and the composer showing GPT-5.5 via ChatGPT sign-in"
            glow
            priority
            caption="A real turn on a ChatGPT subscription: four steps, one edit, the diff inline. Every screenshot on this page is the built app against a real pi."
          />
        </div>
      </div>
    </section>

    <!-- ======================================================= PROVIDERS -->
    <section id="providers" class="band py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow eyebrow--accent">Providers</p>
          <h2 class="headline mt-4 text-3xl md:text-4xl">One window, every provider pi speaks.</h2>
          <p class="lede mt-5 text-lg">
            pi's native providers and installed provider packages sit in one searchable, starrable
            picker. Switch models mid-session and the conversation carries over; the chip names what
            actually serves the session, so a Claude on your Max plan never masquerades as the API.
          </p>
        </div>

        <div class="marquee mt-12 overflow-hidden" data-reveal aria-hidden="true">
          <div class="marquee-track">
            {
              [...providers, ...providers].map((p) => (
                <span class="chip px-3 py-2 text-[12.5px]">
                  <span class="font-semibold text-text">{p.mono}</span>
                  {p.name}
                </span>
              ))
            }
          </div>
        </div>

        <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" role="list">
          {
            providers.map((p, i) => (
              <li class="card flex items-start gap-3 p-3.5" data-reveal style={`--i: ${i % 6}`}>
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-chip font-mono text-[12px] font-semibold text-text">
                  {p.mono}
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-[13.5px] font-medium text-text">{p.name}</span>
                  <span class="block text-xs text-text-tertiary">{p.how}</span>
                  <span
                    class={`chip mt-1.5 px-1.5 py-1 text-[10px] ${p.kind === 'plan' ? 'chip--accent' : ''}`}
                  >
                    {kindLabel[p.kind]}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-16 grid items-center gap-10 lg:grid-cols-[1fr_1.5fr]">
          <ul class="feature-list space-y-4 text-[15px]" data-reveal>
            <li>
              <strong>Hundreds of models, one search.</strong> Filter by provider chip, search by
              name (<code class="inline">opus bedrock</code>, <code class="inline">provider:aws</code>),
              star the ones you use, group by provider or model.
            </li>
            <li>
              <strong>Switch mid-session.</strong> Start on a cheap model, finish on a strong one —
              the transcript is pi's, so nothing is lost in the handover.
            </li>
            <li>
              <strong>Thinking ladder.</strong> Models with reasoning levels get a second chip:
              off through xhigh, per session, remembered in drafts.
            </li>
            <li>
              <strong>Context and cost, live.</strong> Window size, tokens per class and session
              cost per model, priced from the catalogue.
            </li>
          </ul>
          <div data-reveal style="--i: 1">
            <Shot
              src={shotModels}
              alt="The model menu open over the composer: provider filter chips for Bedrock, a local server, ChatGPT, OpenRouter and the Claude Code provider, with 546 models listed"
              sizes="(min-width: 1024px) 60vw, 94vw"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================== ACCOUNTS -->
    <section id="accounts" class="band band--sunken py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <div class="grid items-start gap-12 lg:grid-cols-[1.4fr_1fr]">
          <div data-reveal>
            <Shot
              src={shotAccounts}
              alt="Settings → Accounts: ChatGPT (Codex) signed in, plus Claude Pro/Max, GitHub Copilot and Kimi rows with Sign in buttons, and a billed-per-token section"
              sizes="(min-width: 1024px) 58vw, 94vw"
            />
          </div>
          <div>
            <p class="eyebrow eyebrow--accent" data-reveal>OAuth · subscriptions</p>
            <h2 class="headline mt-4 text-3xl md:text-4xl" data-reveal style="--i: 1">
              Sign in with the plan you already pay for.
            </h2>
            <p class="lede mt-5" data-reveal style="--i: 2">
              No API key required. Settings → Accounts drives pi's own login flow for each
              provider, off-screen, and shows which account is signed in. Phosphor never stores a
              credential — pi's auth store and the vendor CLI's keychain do.
            </p>
            <ul class="feature-list mt-7 space-y-3.5 text-[15px]" data-reveal style="--i: 3">
              <li>
                <strong>ChatGPT Plus / Pro.</strong> pi's native Codex OAuth — a path OpenAI names
                as supported for open-source clients, pi included.
              </li>
              <li>
                <strong>Claude Pro / Max.</strong> Anthropic forbids lifting a subscription token
                into another client, so <a class="underline decoration-border-strong underline-offset-4 hover:text-text" href={PI_CLAUDE_CLI} target="_blank" rel="noopener noreferrer">pi-claude-cli</a>
                drives the official Claude Code binary instead — the sanctioned way to spend the
                plan, with plan-limit windows visible in the app.
              </li>
              <li><strong>GitHub Copilot and Kimi For Coding</strong> sign in the same way.</li>
              <li>
                <strong>Billed per token</strong> — xAI, OpenRouter, Radius — sign in against a
                credit balance. API keys and local endpoints live in pi's config, editable from the
                Agent and Advanced tabs.
              </li>
              <li>
                <strong>Switching accounts</strong> ends on the credential actually changing, not
                on a stale "ready", so re-login never kills its own callback server.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================= GATEWAY -->
    <section id="gateway" class="band py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow eyebrow--accent">Gateway orchestration</p>
          <h2 class="headline mt-4 text-3xl md:text-4xl">
            A gateway in front of your accounts, your tools and your context.
          </h2>
          <p class="lede mt-5 text-lg">
            Running many lanes at once is the normal case, so Phosphor puts a routing layer in
            front of the things that run out: plan windows, tool schemas and the context window
            itself.
          </p>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-3">
          <article class="card p-6" data-reveal>
            <p class="eyebrow">Account gateway</p>
            <h3 class="mt-3 text-xl font-semibold">Several Claude logins, one per lane.</h3>
            <ul class="feature-list mt-4 space-y-2.5 text-sm">
              <li>Keep as many Claude accounts as you have plans; each session is bound to one at spawn.</li>
              <li>Routing modes: <strong>specific</strong>, <strong>ordered</strong>, <strong>round-robin</strong>.</li>
              <li>An account is held back while it is rejected, at its 5-hour window, or spending overage credits.</li>
              <li>Move a lane to another account, or restart it on the same one — the session file is the source of truth.</li>
              <li>Each account row opens onto its own usage windows and the live sessions spending it.</li>
            </ul>
          </article>
          <article class="card p-6" data-reveal style="--i: 1">
            <p class="eyebrow">MCP gateway</p>
            <h3 class="mt-3 text-xl font-semibold">Any number of servers, one tool in context.</h3>
            <ul class="feature-list mt-4 space-y-2.5 text-sm">
              <li>Connectors reach the model through a single <code class="inline">mcp</code> gateway plus <code class="inline">mcpScript</code> for batching.</li>
              <li>About 3.9 KB of schema no matter how many servers are mounted; tools are searched and described on demand.</li>
              <li>Opt a server into flat tools when you want them always-on — the meter shows what that costs.</li>
              <li>The context meter attributes MCP cost per server, so you know which connector to disconnect.</li>
              <li>Claude Code sessions reach MCP through pi, never around it — strict isolation from the CLI's own config.</li>
            </ul>
          </article>
          <article class="card p-6" data-reveal style="--i: 2">
            <p class="eyebrow">Context gateway</p>
            <h3 class="mt-3 text-xl font-semibold">Compression and advice, measured.</h3>
            <ul class="feature-list mt-4 space-y-2.5 text-sm">
              <li>A local Headroom proxy compresses large JSON tool results the moment they are produced — lossless families only, fails open.</li>
              <li>Measured 24–45% smaller on uniform JSON records, 45% aggregate across 35 live compressions.</li>
              <li>Settings → Optimization manages the proxy, shows saved tokens per lane, and runs the Advisor.</li>
              <li>Advisor rules: cache churn, compression coverage, MCP schema weight, long-session drag. Advice only, nothing acts.</li>
              <li>OpenRouter, Cloudflare and Vercel AI gateways are ordinary providers, so gateway routing is one chip away too.</li>
            </ul>
          </article>
        </div>

        <div class="mt-14 grid items-center gap-10 lg:grid-cols-[1fr_1.5fr]">
          <div data-reveal>
            <p class="eyebrow">The context meter</p>
            <h3 class="headline mt-3 text-2xl">Full of what, exactly.</h3>
            <p class="lede mt-4 text-[15px]">
              pi reports context as one number. A bundled extension measures the composition from
              inside the process — messages, system prompt, tool schemas, MCP schemas per server —
              and the popover scales the estimate onto pi's real total, labelled as an estimate. On
              a Claude Code session it also shows the plan's 5-hour, weekly and per-model windows
              for the account this lane is spending, and the binding limit as the provider relays
              it.
            </p>
          </div>
          <div data-reveal style="--i: 1">
            <Shot
              src={shotContext}
              alt="The context meter popover: window usage bar, composition legend, MCP servers with token cost each, tokens and session cost, plan usage dials at 73%, 40% and 64%"
              sizes="(min-width: 1024px) 60vw, 94vw"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ CHAT -->
    <section id="chat" class="band band--surface py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.4fr]">
          <div>
            <p class="eyebrow eyebrow--accent" data-reveal>The transcript</p>
            <h2 class="headline mt-4 text-3xl md:text-4xl" data-reveal style="--i: 1">
              A transcript, not a blob.
            </h2>
            <p class="lede mt-5" data-reveal style="--i: 2">
              Streaming prose with the run's activity folded into steps: file edits expand to
              their diff, tool calls to their arguments and output, thinking to its own block.
              Claude Code's own tools and sub-agents render in the same vocabulary as pi's.
            </p>
            <ul class="feature-list mt-7 space-y-3 text-[15px]" data-reveal style="--i: 3">
              <li><strong>Rich responses are first-class:</strong> GFM tables, Shiki-highlighted code, Mermaid, Chart.js and Vega-Lite specs, KaTeX, and model-authored HTML in a sandboxed iframe on its own origin with no network.</li>
              <li><strong>The composer:</strong> <code class="inline">@</code> mentions workspace files, <code class="inline">/</code> opens pi's commands, skills and templates, <code class="inline">!</code> runs a shell line into context, <code class="inline">!!</code> keeps it out.</li>
              <li><strong>Steer or queue.</strong> Enter mid-turn steers after the current tool call; Cmd+Enter queues a follow-up. Both queues are visible and each entry can be withdrawn.</li>
              <li><strong>Drafts persist</strong> across sessions and restarts, images included; formatting is keyboard-only, and long prompts expand to half the window.</li>
              <li><strong>Paced streaming.</strong> Coarse provider deltas are revealed at a steady rate; hydrated history never replays a typewriter.</li>
              <li><strong>No permission prompts.</strong> pi runs in full-permission mode; tool calls execute and stream. Third-party approval gates render as a review sheet where deny is the default.</li>
            </ul>
          </div>
          <div class="space-y-6">
            <div data-reveal>
              <Shot
                src={shotThinking}
                alt="The thinking-level menu open on a Claude Fable 5 session, offering reasoning effort levels"
                sizes="(min-width: 1024px) 58vw, 94vw"
              />
            </div>
            <div class="grid gap-6 sm:grid-cols-2">
              <div data-reveal style="--i: 1">
                <Shot
                  src={shotCommands}
                  alt="The slash-command menu listing pi commands, skills and Phosphor's own actions"
                  sizes="(min-width: 1024px) 28vw, 45vw"
                  widths={[480, 800, 1200]}
                />
              </div>
              <div data-reveal style="--i: 2">
                <Shot
                  src={shotMentions}
                  alt="The @ file-mention menu resolved against the workspace tree"
                  sizes="(min-width: 1024px) 28vw, 45vw"
                  widths={[480, 800, 1200]}
                />
              </div>
            </div>
          </div>
        </div>

        <div class="mt-20 grid items-center gap-10 lg:grid-cols-[1.5fr_1fr]">
          <div data-reveal>
            <Shot
              src={shotChanges}
              alt="The Changes pane beside the transcript: files changed with per-file add and remove counts, next to the edit's diff"
              sizes="(min-width: 1024px) 60vw, 94vw"
            />
          </div>
          <div>
            <p class="eyebrow eyebrow--accent" data-reveal>Changes</p>
            <h3 class="headline mt-4 text-2xl md:text-3xl" data-reveal style="--i: 1">
              Every change is reviewable.
            </h3>
            <ul class="feature-list mt-6 space-y-3 text-[15px]" data-reveal style="--i: 2">
              <li>The Changes pane accumulates the agent's edits against a session baseline, with a per-file diff and per-file revert.</li>
              <li>Diffs use the editor's own font and size, open with focus on a Back button, and return focus to the row that opened them.</li>
              <li>A diff card in the transcript is the same diff; click it to open the file at the first changed line.</li>
              <li>Edit cards feed the sidebar's <code class="inline">±N</code> count, so a lane's footprint is visible before you open it.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================== LANES -->
    <section id="lanes" class="band py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow eyebrow--accent">Lanes</p>
          <h2 class="headline mt-4 text-3xl md:text-4xl">
            A session, its branch, its worktree and its PR — one row.
          </h2>
          <p class="lede mt-5 text-lg">
            Many sessions at once is the normal case. A new chat gets its own branch cut from the
            remote trunk and its own worktree, is named after itself once the first turn lands, and
            shows up on the home board in the column that says what it needs from you.
          </p>
        </div>

        <div class="mt-12" data-reveal>
          <Shot
            src={shotHome}
            alt="The home screen as a lane board: one lane ready to merge with a Merge button, six idle lanes, a ledger of spend, tokens and live processes, and spend by lane"
            glow
          />
        </div>

        <div class="mt-14 grid gap-10 lg:grid-cols-3">
          <div data-reveal>
            <p class="eyebrow">The board</p>
            <ul class="mt-4 space-y-3">
              {
                laneColumns.map((c) => (
                  <li class="card card--quiet p-3.5">
                    <span class="block text-[14px] font-semibold text-text">{c.name}</span>
                    <span class="block text-sm text-text-secondary">{c.from}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-4 text-sm text-text-tertiary">
              Every column is derived from state the app already holds. The board renders with no
              live session, survives a restart and spends no tokens.
            </p>
          </div>

          <div data-reveal style="--i: 1">
            <p class="eyebrow">The row</p>
            <div class="mt-4 rounded-[10px] border border-border bg-sidebar p-2 select-none" aria-hidden="true">
              <p class="eyebrow flex items-center gap-2 px-2 pt-1 pb-2">
                phosphor <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
              </p>
              <div class="lane-rail relative flex items-center gap-2.5 rounded-md bg-sidebar-active px-2.5 py-2">
                <Beacon size={20} label="Working" />
                <div class="min-w-0 flex-1">
                  <div class="truncate text-[13.5px] text-text">Artifact link handler</div>
                  <div class="flex items-center gap-1.5 truncate text-[12px] text-text-secondary">
                    <span class="lane-activity rounded bg-accent-soft px-1 font-semibold text-text">Working</span>
                    <span>·</span><span class="chip px-1 py-0.5 text-[10px]">wt</span><span>·</span>
                    <span class="truncate font-mono">phosphor/artifact-link-handler</span>
                    <span>·</span><span class="text-accent">±3</span>
                  </div>
                </div>
                <span class="chip chip--success ml-auto text-[10.5px]">#237</span>
              </div>
              <div class="flex items-center gap-2.5 rounded-md px-2.5 py-2">
                <span class="h-2 w-2 rounded-full bg-success"></span>
                <span class="w-[18px] text-center">🚀</span>
                <div class="min-w-0 flex-1">
                  <div class="truncate text-[13.5px] text-text">Global review settings</div>
                  <div class="truncate text-[12px] text-text-secondary">
                    2m ago · <span class="chip px-1 py-0.5 text-[10px]">wt</span> · <span class="font-mono">phosphor/global-review</span>
                  </div>
                </div>
                <span class="chip chip--success ml-auto text-[10.5px]">#239 ✓✓</span>
              </div>
              <div class="flex items-center gap-2.5 rounded-md px-2.5 py-2">
                <span class="h-2 w-2 rounded-full border border-text-tertiary"></span>
                <span class="w-[18px] text-center">🧪</span>
                <div class="min-w-0 flex-1">
                  <div class="truncate text-[13.5px] text-text">Double loading refinement</div>
                  <div class="truncate text-[12px] text-text-secondary">
                    35m ago · <span class="chip px-1 py-0.5 text-[10px]">wt</span> · <span class="font-mono">phosphor/double-loading</span>
                  </div>
                </div>
                <span class="chip chip--danger ml-auto text-[10.5px]">#238</span>
              </div>
              <div class="flex items-center gap-2.5 rounded-md px-2.5 py-2">
                <span class="h-2 w-2 rounded-full border border-text-tertiary"></span>
                <span class="w-[18px] text-center">🔖</span>
                <div class="min-w-0 flex-1">
                  <div class="truncate text-[13.5px] text-text">Headroom optimization</div>
                  <div class="truncate text-[12px] text-text-secondary">
                    11h ago · <span class="chip px-1 py-0.5 text-[10px]">wt</span> · <span class="font-mono">phosphor/headroom</span>
                  </div>
                </div>
                <span class="chip chip--merged ml-auto text-[10.5px]">#231</span>
              </div>
            </div>
            <ul class="mt-4 space-y-2">
              {
                prChipStates.map((s) => (
                  <li class="flex items-center gap-3 text-sm text-text-secondary">
                    <span class={`chip w-20 justify-center text-[10.5px] ${toneClass[s.tone]}`}>{s.label}</span>
                    {s.meaning}
                  </li>
                ))
              }
            </ul>
          </div>

          <div data-reveal style="--i: 2">
            <p class="eyebrow">Lane management</p>
