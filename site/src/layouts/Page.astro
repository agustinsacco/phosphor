---
import '../styles/global.css'
import { repo } from '../lib/content'
interface Props {
  title?: string
  description?: string
}
const {
  title = 'Phosphor | Parallel coding. Without losing the thread.',
  description = 'Run independent pi sessions, review changes, and connect your tools. A desktop workspace for your models, subscriptions, and pi extensions.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e1c18" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Phosphor. Parallel coding. Without losing the thread. Powered by pi and your extensions."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Phosphor home"
          ><img src="/favicon.svg" width="36" height="36" alt="" /><span>Phosphor</span></a
        >
        <nav aria-label="Main navigation">
          <a href="/guides/">Guides</a><a href="/#work">Workflow</a><a href="/#extensions"
            >Extensions</a
          ><a href="/#connectors">Connectors</a>
        </nav>
        <a class="header-install" href="/guides/#install"
          >Install <span aria-hidden="true">↘</span></a
        >
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <a class="wordmark" href="/"
        ><img src="/favicon.svg" alt="" width="32" height="32" /><span>Phosphor</span></a
      >
      <p>pi’s agent loop. Your workspace.</p>
      <div>
        <a href="/guides/">Guides</a><a href={`${repo}/blob/main/docs/README.md`}
          >Technical docs ↗</a
        ><a href={`${repo}/blob/main/LICENSE`}>MIT license</a><a href={repo}>Source ↗</a><a
          href={`${repo}/issues`}>Get help ↗</a
        ><a href="#main">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>
