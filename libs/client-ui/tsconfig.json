{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"],
      "@phosphor/shared/*": ["../shared/src/*"],
      "@phosphor/host-client/*": ["../host-client/src/*"],
      "@phosphor/session-runtime/*": ["../session-runtime/src/*"]
    }
  },
  "include": ["vitest.config.ts", "src/**/*.ts", "src/**/*.tsx", "../shared/src/**/*.ts"]
}
