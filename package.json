{
  "name": "phosphor",
  "version": "0.1.0",
  "description": "Desktop coding-agent app powered by the pi coding agent",
  "type": "module",
  "private": true,
  "workspaces": [
    "libs/shared",
    "libs/session-runtime",
    "libs/pi-extensions"
  ],
  "scripts": {
    "dev": "npm run dev --prefix apps/desktop --",
    "dev:web": "npm run dev:web --prefix apps/desktop --",
    "build": "npm run build --prefix apps/desktop --",
    "preview": "npm run preview --prefix apps/desktop --",
    "typecheck": "npm run typecheck --prefix apps/desktop --",
    "typecheck:host": "tsc --noEmit -p apps/host/tsconfig.json",
    "build:host": "node apps/host/scripts/build.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "npx --yes supabase@2.119.0 start",
    "db:stop": "npx --yes supabase@2.119.0 stop --no-backup",
    "test:control-db": "npx --yes supabase@2.119.0 test db",
    "test:e2e": "npm run test:e2e --prefix apps/desktop --",
    "validate": "./tools/scripts/validate.sh",
    "shots": "node tools/scripts/capture-readme-shots.mjs",
    "shots:live": "node tools/scripts/capture-live-shots.mjs",
    "pack": "npm run pack --prefix apps/desktop --",
    "dist": "npm run dist --prefix apps/desktop --",
    "dist:mac": "npm run dist:mac --prefix apps/desktop --",
    "dist:linux": "npm run dist:linux --prefix apps/desktop --",
    "dist:win": "npm run dist:win --prefix apps/desktop --",
    "postinstall": "npm ci --prefix apps/desktop",
    "site:install": "npm ci --prefix apps/site",
    "site:dev": "npm run dev --prefix apps/site --",
    "site:check": "npm run check --prefix apps/site --",
    "site:build": "npm run build --prefix apps/site --",
    "site:test": "npm test --prefix apps/site --",
    "nx:build": "nx run desktop:build",
    "nx:typecheck": "nx run tooling:typecheck",
    "nx:lint": "nx run tooling:lint",
    "nx:test": "nx run tooling:test",
    "nx:test:e2e": "nx run desktop:test:e2e",
    "nx:validate": "nx run tooling:validate",
    "nx:graph": "nx graph"
  },
  "author": {
    "name": "Phosphor",
    "email": "saccoagustin@hotmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/agustinsacco/Phosphor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agustinsacco/Phosphor.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.25.12",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "nx": "23.2.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typebox": "^1.3.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "ws": "8.21.0",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1",
    "luxon": "^3.7.2",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.1",
    "unicode-emoji-json": "^0.9.0",
    "vega-embed": "^7.1.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "nx@23.2.1": {
      "axios": "1.20.0",
      "brace-expansion": "5.0.12",
      "smol-toml": "1.9.0"
    }
  }
}
