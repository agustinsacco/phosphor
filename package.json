{
  "name": "phosphor",
  "version": "0.1.0",
  "description": "Desktop coding-agent app powered by the pi coding agent",
  "type": "module",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && ./scripts/e2e.sh",
    "validate": "./scripts/validate.sh",
    "shots": "node scripts/capture-readme-shots.mjs",
    "shots:live": "node scripts/capture-live-shots.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-node-pty.mjs"
  },
  "author": {
    "name": "Phosphor",
    "email": "saccoagustin@hotmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/agustinsacco/Phosphor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agustinsacco/Phosphor.git"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typebox": "^1.3.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.1",
    "vega-embed": "^7.1.0",
    "zustand": "^5.0.14"
  }
}
