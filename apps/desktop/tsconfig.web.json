{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // "node" is needed because renderer test files read fixtures from disk.
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/renderer/**/*.ts",
    "test/renderer/**/*.tsx",
    "vite.config.ts",
    "../../libs/shared/src/**/*.ts"
  ]
}
