{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "desktop",
  "root": "apps/desktop",
  "projectType": "application",
  "tags": ["scope:desktop"],
  "implicitDependencies": ["runtime", "shared", "host-client", "pi-extensions", "client-ui"],
  "namedInputs": {
    "release": [
      "{workspaceRoot}/tools/scripts/fix-node-pty.mjs",
      "{workspaceRoot}/tools/scripts/install.sh",
      "{workspaceRoot}/tools/scripts/should-skip-release.sh",
      "{workspaceRoot}/tools/scripts/release-scope.mjs",
      "{workspaceRoot}/.github/workflows/release-continuous.yml"
    ],
    "e2eHarness": [
      "{workspaceRoot}/tools/scripts/e2e.sh",
      "{workspaceRoot}/tools/scripts/desktop-electron-launch.mjs",
      "{workspaceRoot}/tools/scripts/desktop-electron-loader.cjs"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "rootInstall", "release"],
      "options": {
        "command": "npm run build",
        "cwd": "apps/desktop"
      },
      "outputs": ["{projectRoot}/out"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "rootInstall", "release", "e2eHarness"],
      "options": {
        "command": "npm run test:e2e",
        "cwd": "apps/desktop"
      }
    }
  }
}
