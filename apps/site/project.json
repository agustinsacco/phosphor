{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "site",
  "root": "apps/site",
  "projectType": "application",
  "tags": ["scope:site"],
  "implicitDependencies": [],
  "namedInputs": {
    "deploy": [
      "{workspaceRoot}/apps/control/**/*",
      "{workspaceRoot}/libs/shared/src/**/*",
      "{workspaceRoot}/tools/scripts/site-image.sh",
      "{workspaceRoot}/.infra/phosphor-site/**/*",
      "{workspaceRoot}/.github/workflows/deploy-site.yml",
      "{workspaceRoot}/tools/scripts/site-deploy-policy.mjs",
      "{workspaceRoot}/tools/scripts/site-web-*.mjs",
      "{workspaceRoot}/tools/scripts/should-skip-release.sh",
      "{workspaceRoot}/apps/web/**/*",
      "{workspaceRoot}/libs/client-ui/**/*",
      "{workspaceRoot}/libs/pi-extensions/**/*",
      "{workspaceRoot}/libs/host-client/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "deploy"],
      "options": {
        "command": "npm run build",
        "cwd": "apps/site"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/public/og.png"]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run check",
        "cwd": "apps/site"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm test",
        "cwd": "apps/site"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run dev",
        "cwd": "apps/site"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run start",
        "cwd": "apps/site"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run prebuild",
        "cwd": "apps/site"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run preview",
        "cwd": "apps/site"
      }
    },
    "shots": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run shots",
        "cwd": "apps/site"
      }
    },
    "shots:guides": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run shots:guides",
        "cwd": "apps/site"
      }
    },
    "audit:links": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run audit:links",
        "cwd": "apps/site"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "npm run format",
        "cwd": "apps/site"
      }
    }
  }
}
