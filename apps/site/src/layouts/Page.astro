---
import '../styles/global.css'
import { releases, repo } from '../lib/content'
interface Props {
  title?: string
  description?: string
}
const {
  title = 'Phosphor | Ten agents. Ten branches. One window.',
  description = 'Open-source desktop app for the pi coding agent. Run agents in parallel, each on its own Git worktree, review every diff, and use the models you already pay for.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e1c18" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Phosphor. Ten agents. Ten branches. One window. Open-source desktop app for the pi coding agent."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Phosphor home"
          ><img src="/favicon.svg" width="36" height="36" alt="" /><span>Phosphor</span></a
        >
        <nav aria-label="Main navigation">
          <a href="/guides/">Guides</a><a href="/#work">Workflow</a><a href="/#extensions"
            >Extensions</a
          ><a href="/#connectors">Connectors</a>
        </nav>
        <div class="header-links">
          <a class="header-link" href={repo}
            ><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"
              ><path
                fill="currentColor"
                d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
              ></path></svg
            ><span class="header-link-label">GitHub</span></a
          ><a class="header-link" href={`${releases}/latest`}
            >Releases <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <a class="wordmark" href="/"
        ><img src="/favicon.svg" alt="" width="32" height="32" /><span>Phosphor</span></a
      >
      <p>Built on pi, by engineers for engineers.</p>
      <div>
        <a href="/guides/">Guides</a><a href={`${repo}/blob/main/docs/README.md`}
          >Technical docs ↗</a
        ><a href={`${repo}/blob/main/LICENSE`}>MIT license</a><a href={repo}>Source ↗</a><a
          href={`${repo}/issues`}>Get help ↗</a
        ><a href="#main">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>
