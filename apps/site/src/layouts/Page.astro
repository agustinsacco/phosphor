---
import '../styles/global.css'
import { releases, repo } from '../lib/content'
interface Props {
  title?: string
  description?: string
}
const {
  title = 'Phosphor | One mission. Many agents. Your IDE.',
  description = 'The open-source multi-agent IDE built on pi. Work in parallel lanes, delegate bounded tasks, inspect every decision and diff, and use the models you already pay for.',
} = Astro.props
const webEnabled = import.meta.env.PUBLIC_PHOSPHOR_WEB_ENABLED === 'true'
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e1c18" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Phosphor. One mission. Many agents. Your IDE. The open-source multi-agent IDE built on pi."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class:list={['header-inner', { 'web-enabled': webEnabled }]}>
        <a class="wordmark" href="/" aria-label="Phosphor home"
          ><img src="/favicon.svg" width="36" height="36" alt="" /><span>Phosphor</span></a
        >
        <nav aria-label="Main navigation">
          <a href="/guides/">Guides</a><a href="/#swarm">Swarm</a><a href="/#extensions"
            >Extensions</a
          ><a href="/#faq">FAQ</a>
        </nav>
        <div class="header-links">
          {
            webEnabled && (
              <a class="header-link" href="https://phosphor-app.saccolabs.com/">
                Open the app
              </a>
            )
          }
          <a class="header-link" href={repo}
            ><span class="github-mark" aria-hidden="true"></span><span class="header-link-label"
              >GitHub</span
            ></a
          ><a class="header-link" href={`${releases}/latest`}
            >Releases <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <a class="wordmark" href="/"
        ><img src="/favicon.svg" alt="" width="32" height="32" /><span>Phosphor</span></a
      >
      <p>Built on pi, by engineers for engineers.</p>
      <div>
        <a href="/guides/">Guides</a><a href={`${repo}/blob/main/docs/README.md`}
          >Technical docs ↗</a
        ><a href={`${repo}/blob/main/LICENSE`}>MIT license</a><a href={repo}>Source ↗</a><a
          href={`${repo}/issues`}>Get help ↗</a
        ><a href="#main">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>
