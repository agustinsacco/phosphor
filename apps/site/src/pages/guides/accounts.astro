---
import Guide from '../../layouts/Guide.astro'
import Capture from '../../components/Capture.astro'
import Command from '../../components/Command.astro'
import { doc, piDoc, shot } from '../../lib/content'
const sections: [string, string][] = [
  ['plans', 'Which plans work'],
  ['recommended', 'The setup we recommend'],
  ['pi-accounts', 'ChatGPT, Copilot, and Kimi'],
  ['prerequisites', 'Claude: before you begin'],
  ['install', 'Claude: install the provider'],
  ['sign-in', 'Claude: add an account'],
  ['verify', 'Claude: test and select'],
  ['multiple-accounts', 'Claude: add more accounts'],
