{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "control",
  "root": "apps/control",
  "sourceRoot": "apps/control/src",
  "projectType": "application",
  "tags": ["scope:control"],
  "implicitDependencies": ["shared"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "rootInstall"],
      "options": {
        "command": "tsc --noEmit -p apps/control/tsconfig.json",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "rootUnitRunner"],
      "options": {
        "command": "vitest run apps/control",
        "cwd": ".",
        "env": {
          "VITEST_MAX_WORKERS": "2"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "rootInstall"],
      "options": {
        "command": "node apps/control/scripts/build.mjs",
        "cwd": "."
      },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
