{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tooling",
  "root": "tools/scripts",
  "projectType": "library",
  "tags": ["scope:tooling"],
  "implicitDependencies": [
    "desktop",
    "host",
    "control",
    "runtime",
    "host-client",
    "shared",
    "pi-extensions",
    "site",
    "schema",
    "client-ui",
    "web"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "node tools/scripts/typecheck.mjs",
        "cwd": "."
      },
      "outputs": []
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "eslint . && oxlint --type-aware .",
        "cwd": "."
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "vitest run",
        "cwd": ".",
        "env": {
          "VITEST_MAX_WORKERS": "2"
        }
      },
      "configurations": {
        "inventory": {
          "command": "vitest list --filesOnly --json"
        }
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "./tools/scripts/validate.sh",
        "cwd": "."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "prettier --check .",
        "cwd": "."
      }
    },
    "test:graph": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["workspace"],
      "options": {
        "command": "vitest run tools/scripts/nx-projects.test.ts",
        "cwd": ".",
        "env": {
          "VITEST_MAX_WORKERS": "2"
        }
      }
    }
  }
}
