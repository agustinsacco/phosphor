{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "vitest.config.ts",
    "tools/scripts/**/*.ts",
    "tools/scripts/**/*.tsx",
    "tools/scripts/**/*.mts",
    "tools/scripts/**/*.cts",
    "tools/host-release/**/*.ts",
    "tools/host-release/**/*.tsx",
    "tools/host-release/**/*.mts",
    "tools/host-release/**/*.cts"
  ]
}
